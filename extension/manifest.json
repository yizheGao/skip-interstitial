{
  "manifest_version": 3,
  "name": "安全检测自动跳过（QQ/微信/豆包·抖音外链直达）",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "自动跳过腾讯（QQ/微信）与字节（豆包/抖音/头条）安全检测中间页（含“已停止访问”），支持两家检测页互相套娃；完全拉黑时从“申请恢复”链接的 base64 还原目标，且不误跳客服页。",
  "permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "*://c.pc.qq.com/*",
    "*://c.q.qq.com/*",
    "*://pingtas.qq.com/*",
    "*://cgi.connect.qq.com/*",
    "*://weixin110.qq.com/*",
    "*://weixin.qq.com/cgi-bin/*",
    "*://mp.weixin.qq.com/mp/*",
    "*://*.wtturl.cn/*",
    "*://wtturl.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://c.pc.qq.com/*",
        "*://c.q.qq.com/*",
        "*://pingtas.qq.com/*",
        "*://cgi.connect.qq.com/*",
        "*://weixin110.qq.com/*",
        "*://weixin.qq.com/cgi-bin/readtemplate*",
        "*://mp.weixin.qq.com/mp/redirect*",
        "*://*.wtturl.cn/*",
        "*://wtturl.cn/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://c.pc.qq.com/*",
        "*://c.q.qq.com/*",
        "*://pingtas.qq.com/*",
        "*://cgi.connect.qq.com/*",
        "*://weixin110.qq.com/*",
        "*://weixin.qq.com/cgi-bin/readtemplate*",
        "*://mp.weixin.qq.com/mp/redirect*",
        "*://*.wtturl.cn/*",
        "*://wtturl.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
